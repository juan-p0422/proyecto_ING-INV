# Docker Compose lee este archivo si lo copias como .env en la raiz.
# No confirmes el archivo .env real en Git.
POSTGRES_DB=eduroom
POSTGRES_USER=eduroom
POSTGRES_PASSWORD=cambia_esta_clave
DATABASE_URL=postgresql://eduroom:cambia_esta_clave@localhost:5432/eduroom?schema=public
JWT_SECRET=cambia_este_secreto_por_uno_de_al_menos_32_caracteres
APP_ENCRYPTION_KEY=cambia_esta_clave_de_cifrado_por_64_caracteres_hexadecimales
PORT=3000
NODE_ENV=production
CORS_ORIGIN=http://localhost:3000
STRICT_INTEGRITY=false

# Variables opcionales.
JWT_EXPIRES_IN=8h
INTEGRITY_MANIFEST_PATH=
# Usa /api cuando Express sirve el frontend. Para Vite separado: http://localhost:3000/api.
VITE_API_URL=/api
